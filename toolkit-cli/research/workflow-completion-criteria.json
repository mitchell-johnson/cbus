{
  "schema_version": 1,
  "target": "C-Bus Toolkit 1.18.0.2754 / C-Gate 3.4.0.2001",
  "purpose": "Reviewed workflow completion criteria. Each Toolkit help workflow family, plus the C-Gate command service, names the acceptance dimensions every member obligation must require, the oracles that judge them, and whether physical and persistence/recovery evidence is required. Ledger rows are allocated to exactly one workflow; derived C-Gate path and function obligations inherit their row's workflow.",
  "workflows": [
    {
      "id": "workflow:projects",
      "family_id": "projects",
      "source": "toolkit_help_workflow_family",
      "name": "Project lifecycle and backup",
      "allocation": "final",
      "minimum_dimensions": [
        "nominal",
        "error",
        "invalid_input",
        "original_differential",
        "persistence_recovery"
      ],
      "oracles": [
        "cgate",
        "gui",
        "model"
      ],
      "physical_evidence": "not_required",
      "persistence_evidence": "required",
      "rationale": "Project create/open/backup/restore is judged against original Toolkit project files and C-Gate project state; saved files must survive reopen and interrupted writes. Bus effects belong to the commissioning and programming workflows."
    },
    {
      "id": "workflow:networks",
      "family_id": "networks",
      "source": "toolkit_help_workflow_family",
      "name": "Network configuration and connections",
      "allocation": "final",
      "minimum_dimensions": [
        "nominal",
        "error",
        "invalid_input",
        "profile_variation",
        "original_differential",
        "physical",
        "persistence_recovery"
      ],
      "oracles": [
        "cgate",
        "gui",
        "model",
        "physical"
      ],
      "physical_evidence": "required",
      "persistence_evidence": "required",
      "rationale": "Network and interface configuration only completes when a real CNI/PCI/USB interface connects, across interface profiles, and the saved network definition reconnects after restart."
    },
    {
      "id": "workflow:applications",
      "family_id": "applications",
      "source": "toolkit_help_workflow_family",
      "name": "Applications, groups and levels",
      "allocation": "final",
      "minimum_dimensions": [
        "nominal",
