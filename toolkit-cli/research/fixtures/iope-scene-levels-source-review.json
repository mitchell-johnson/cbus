    "percent_conversion": "only unequal loaded display invokes HandleLevelAsPercentAfterChange0xd16170; percent*255 div100",
    "raw_display": "HandleLevelAfterChange0xd16084 computes (raw+2)*100 div255 under rawattributeFlag; display callbacks cannot reconvert flaggedraw",
