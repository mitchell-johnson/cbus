  "semantics": {
    "initialization": "Snapshot-derived slider positions with sync checkboxes false; no implicit binding writes or complete GUI lifecycle. Delay position clamps to5 but delay histories refuse stored active delay<5.",
    "same_position": "SetPosition0xc08dec calls FixPosition then compares current position before editing; no-op preserves noncanonical raw bytes and suppresses parent callback.",
    "loaded_percent": "GetVertPosition and ControllerValueChange derive percent=(raw+2)*100 div255; writes use PercentToLevel=p*255 div100.",
    "initial_sync": "DFM checkboxes omit Checked/State (default false) and OnClick. Changing them alone writes no parameter.",
    "percentage_choices": "PopulateStaggerCombo creates integer strings1..100 div channel_count; copies list to max and recovery combos.",
    "control_bounds": "Turn-on min/max0..100. Recovery delay5..255. FixPosition clamps before equality check.",
    "stagger": "Every Stagger sets its tab sync=false first; list order0..N-1; helper setters guard parent notification, retain local coupling.",
    "minimum_stagger": "k*(i+1); dimmer-only visible; no last-channel100 correction.",
