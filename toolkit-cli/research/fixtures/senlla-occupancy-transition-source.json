  "rules": {
    "bank_event": "For each referenced block in key reference order, find its ST7 bank. If any current occupancy flagtrue directly call SetSwitchActive(false), even if Allowed alreadyfalse. Then SetSwitchAllowed(notAnyFlags and not(maintenanceActive and same maintenanceBlock)).",
    "direct_GUI338_edits_excluded": true,
    "equal_boolean_writes_have_no_events": true,
    "macro_enum_domain": [
      0,
      58
    ],
    "nested_unequal_clears_deliver_events_before_initiator": true,
    "nil_handler_default_during_raw_load": true,
    "no_cross_key_aggregate": true,
    "raw_load": "For each key: if rawL and rawD set Anytrue; otherwise set Light(rawL), Dark(rawD), Anyfalse. Set Sunset(rawS) last. Light/Dark/Any true wrappers clear the other movement flags before their own EventFlagChanged. Sunset has no mutual exclusion.",
    "raw_parameter_shape": {
      "PIRDark": {
        "bit_size": 8,
        "element_count": 1,
        "offset": 52
      },
      "PIRDarkMovement": {
        "bit_size": 8,
        "element_count": 1,
        "offset": 51
      },
      "PIRLightMovement": {
        "bit_size": 8,
        "element_count": 1,
        "offset": 50
      },
      "packing": "Key index i is bit 1 << i. Light OR Any enters LightMovement; Dark OR Any enters DarkMovement; Sunset enters PIRDark. Each parameter result contains one unsigned byte."
    },
    "scene_types": [
      24,
      25
    ],
    "special_macro_types": [
      29,
      30,
      33,
      34
    ],
    "unit_state2_is_destruction": true
  },
  "scope": "Internal explicit occupancy flag/Smart/bank-event transitions. No owner construction, complete93 loader/save, application graph, Scene allocator, fresh scalar normalization, direct GUI338 edits, or public CLI admission. Stable movement flags are mutually exclusive.",
  "state_order": [
    "light",
    "dark",
    "any_movement",
    "sunset",
    "decision_pending_0x94",
    "refresh_from_macro_0x95"
  ]
