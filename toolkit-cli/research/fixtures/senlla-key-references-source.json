  "raw_projection": {
    "field": "BlockAllocation",
    "address": 54,
    "array_size": 8,
    "bit_size": 8,
    "rule": "Load each unsigned byte as ascending bits0..7. Later reference append/extract order is retained; save ORs membership bits without sorting references.",
    "primary_block": "First reference when nonempty; otherwise nil.",
    "primary_group": "Only exactly one reference projects that block's group object; zero/multiple projects nil. Per-application unused255 is a real object distinct from nil."
  },
  "association_algorithms": [
    {
      "operation": "add",
      "guard": "If key already owns block, complete no-op.",
      "change": "BeginUpdate(key), append reference, EndUpdate(key). Never sort.",
      "direct_refreshes_when_key_not_updating": [
        "RefreshKeysSecondaryFromBlockSecondary(block)",
        "RefreshPrimaryGroupFromBlockGroups(key)"
      ]
    },
    {
      "operation": "remove",
      "guard": "If key does not own block, complete no-op.",
      "change": "BeginUpdate(key), extract only that reference preserving other order, EndUpdate(key).",
      "direct_refreshes_when_key_not_updating": [
        "RefreshPrimaryGroupFromBlockGroups(key)",
        "RefreshKeysSecondaryFromBlockSecondary(block)"
      ]
    },
    {
      "operation": "transfer",
      "guard": "Collision caller scans keys0..7; only current owners of source receive operations.",
      "change": "For each source-owning key: AddBlock(destination) before RemoveBlock(source). Already-owned destination stays in its original position."
    },
    {
      "operation": "swap_mappings",
      "guard": "Both/neither membership unchanged.",
      "change": "For exclusive membership keys ascending: RemoveBlock(old) then AddBlock(new). Afterwards request conditional indicator remap only if current indicator BlockNumber equals old blockIndex+1. Data swapping is a separate owner phase."
    }
  ],
  "callback_boundaries": {
    "reference_list_change": "Actual reference append/extract emits HandleBlockListNewChange -> owning unit InputKeyBlocksChangedExternal. The component returns mutation evidence; it does not execute unit delegates or nested callbacks.",
    "key_update_guard": "Only the direct refreshes after Add/Remove are suppressed when the key remains updating. Nested external-list/delegate dispatch is an owning lifecycle responsibility.",
    "boolean_noop": "SetAsBoolean compares old value and suppresses all work for unchanged Boolean. Same-app loaded duplicates do not transfer references absent actual Boolean change.",
    "collision_scan": "After changed Secondary Boolean, choose target app; scan all blocks ascending excluding self, nil group, and destination unused255. Probe target GroupByAddress(source numeric address,false), compare object identity against destination group. First collision transfers every owning key ascending, then source group becomes target unused255; continue scan with current255, then bind AppForBlock.",
    "key_application": "Block refresh scans keys ascending, skips updating keys, computes state0 primary/empty,1 secondary,2 both from block Booleans. Actual enum change invokes key app refresh, block secondary refresh, primary-group refresh, level14/15 identification, template derivation, then Scene type23/24/25 reset16 for state1/2. Return/replay these callbacks in owner order rather than deriving from final masks."
  },
  "destination_resolution": {
    "existing": "Existing target application group object bypasses decision.",
    "no_handler": "CreateAllowed defaults true; missing target numeric group is looked up with create=true.",
    "handler": "For missing target, createAllowed starts false; check UNIT PRIMARY application's CanAddGroups even when target is secondary. If true, pass true by-reference to handler, which may decline.",
    "decline": "When target lookup yields nil, target unused255 is resolved create=true and assigned. Old numeric group is not retained.",
    "fresh_timing": "InputUnit.InternalCreate does not set decision pointer1b8/1bc. M8.Initialise assigns it at f94993 after InitialiseFunctionCombos f94932 and SetupFlashHooks f9495c. Entire inherited constructor chain absence of an earlier assignment remains an independently reviewed admission fact.",
    "project_metadata": "Network application202/control group/level create-enabled getters and group tagging can alter project objects. This internal reference component creates no metadata and does not decide handler outcomes."
  },
