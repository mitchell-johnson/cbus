  "original_methods": [
    {
      "method": "EDLTScene.ActionSelector get/set",
      "establishes": "For an editable trigger, both paths call CBusGroup.GetLevelByAddress without overriding create=true. A nonnegative missing action therefore enters native exact-address level creation before DynamicAll refresh."
    },
    {
      "method": "CBusGroup.GetLevelByAddress",
      "establishes": "A missing nonnegative address calls AddLevelRequest(application, group, requested decimal address) once under bContinue recursion protection, then refetches that exact address."
    },
    {
      "method": "TfrmKEYGL5.AddSharpLevel / TLevelManager.FindLevelByAddress",
      "map_ranges": [
        "TfrmKEYGL5.AddSharpLevel 0x011c62ec..0x011c648c",
        "TLevelManager.FindLevelByAddress 0x00f2742c..0x00f2767c"
      ],
      "establishes": "The nonblank request parses the supplied decimal address and calls FindLevelByAddress(create=true, actionSelectorName=true). Creation sets Address and Value to that exact byte, assigns Action Selector %d, adds the object, saves it, and signals ProjectSave. The routine has no combined metadata/PP commit or inverse operation."
    },
    {
      "method": "TLevelManager.GetNextAvailableAddress / GetMaximumPossibleAddress",
      "map_ranges": [
        "GetNextAvailableAddress 0x00f2767c..0x00f276c8",
        "GetMaximumPossibleAddress 0x00f276c8..0x00f276fc"
      ],
      "establishes": "The separate blank add-dialog path scans upward from zero for the first free address. GetHasReservedLevelAddress255 returns true, so that dialog is limited to 0..254 and returns -1 when full. Exact-address ActionSelector creation bypasses this allocator."
    },
    {
      "method": "TCBusApplicationGUIAgent.AddLevel / SceneManager.BtnAddActionSelectorClick",
      "map_range": "AddLevel 0x00cd79ac..0x00cd7e40",
      "establishes": "The user Add button passes a blank level, enters a dialog, seeds Level %d at the first free address, and adds only after acceptance. That interactive path is distinct from automatic exact-address creation."
    },
    {
      "method": "CBusLevel.InitialiseLevel / PopulateDynamicAll",
      "establishes": "A new managed level has four default-language blank TagDLT variants and no all-language records. The automatic projected cache therefore uses four blank, image-free DynamicAll rows and never invents an image fact."
    },
    {
      "method": "Native C-Gate DBADDSAFE Level persistence",
      "establishes": "DBADDSAFE supplies the OID but leaves Level/Value uninitialized. The admitted native path resolves that OID and DBSETSAFE-writes Value=Address before PP SAVE and the later PROJECT SAVE."
    }
  ],
