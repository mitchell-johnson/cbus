  "source_rules": [
    "Load chooses non255 Enable Control before Primary independently for first and second",
    "Save group projection resets all four fields to255 and routes both group addresses using FIRST JoinApplication",
    "JoinApplication has HandleJoinApplicationChange callback; group attributes and SecJoinApplication have no callback installed in InternalCreate",
    "Changing first application clears BOTH groups; this component has no application selection",
    "First/second selectors exclude used block objects, Area, opposite Join and active corridor object",
    "IsUnused fast path accepts second unused object before conflicts",
    "First change handlers only alter UI color/enabled state, including second selector eligibility",
    "SetCBusUnit invokes corridor initialization; states needing corridor writes are refused"
  ],
  "limits": [
    "Existing assigned first group, primary48..95 or Enable Control203",
    "First-group clear, app changes, dual-populated and mixed effective applications refused",
    "Complete Environment Save, recovery normalization, input allocation, macro/scene setters and group creation excluded",
    "Native physical behavior unverified"
  ],
