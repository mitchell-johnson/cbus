  "findings": {
    "use_security": {
      "derivation": "GetUseSecurity af4b9c reads Boolean model attribute +1a0. AfterLoadProgrammingInformation 1258174 copies loaded PP UseSecurity attribute +e8 into that model via SetUseSecurity af4dc0 at12581ff. BeforeSave1258434 reads the model and stages its Boolean; it does not derive security from HouseCode or a network setting. Direct-call scan of .text found the setter only at12581ff; dynamic virtual/external setters are not excluded.",
      "main_save_exclusion": "Attribute +58 cleared at1258521; generic SET guard skips it.",
      "terminal_save": "After main PP SAVE, PROJECT SAVE, and network LoadStatus, wireless AfterSave calls SaveEncryptionParam1257f10. Separate START/LOAD/SET UseSecurity/SAVE timeout6000; existing matching session END retains lock, otherwise acquire lock; only newly owned session gets END/UNLOCK cleanup. SAVE ECGateCommand marks Unit not responding, no replay. Separate result phases required."
    },
    "load_status": {
      "parent_target": "SaveProgrammingInformation cbdef4..cbdf12 loads Network object with exact verb LoadStatus. Network AgentLoad d82abb..d82ac7 dispatches to d83678. This is not unit AgentLoad.",
      "network_behavior": "d83678 obtains InterfaceState, State, SyncState via C-Gate GET command objects against network OID, updates model; catches errors and sets fallback status. No physical unit PSYNC call in this network status path. Server-side cached/network GET behavior must be distinguished from physical polling.",
      "generic_unit_behavior": "Unit AgentLoad cb6636 recognizes LoadStatus, sets LoadingStatus=true and calls CommandDoPSyncAsync timeout10000 atcb665e; PSYNC command helper cc0a20 targets existing unit OID or physical address. Thus generic UNIT LoadStatus cannot be replaced with a fabricated cached status. Separate unit LoadStatus method cc57a8 issues asynchronous voltage GET; NetVoltage verb cb64a8 calls PhysicalUnitGetVoltage which explicitly skips wireless units.",
      "restriction": "Do not issue UNIT LoadStatus/PSYNC or open networks under database-only/no-radio acceptance. Network status reads may fit closed database scope, but native acceptance must verify exact command sequence and cached/error outcomes."
    },
