  "owned_store_feedback_order": [
    {
      "action": "Assign unequal logical High or Low value; handler calls Bank.BeginUpdate, then bound Block.BeginUpdate.",
      "high_sites": [
        "0xcffcf2",
        "0xcffd0c"
      ],
      "low_sites": [
        "0xcffe8a",
        "0xcffea4"
      ],
      "stage": 1
    },
    {
      "action": "Formula3 ceil/clamp conversion writes Store1 for High or Store2 for Low. The corresponding store attribute has no dedicated AfterChange handler.",
      "high_store_site": "0xcffdfb",
      "low_store_site": "0xcfff93",
      "stage": 2
    },
    {
      "action": "Block.EndUpdate publishes current block notification while Bank own updatecounter is still1. Bank HandleBlockChange rejects at GetUpdating, so neither aggregate Allowed nor captured High/Low refresh runs.",
      "bank_guard_site": "0xcff7df",
      "high_end_site": "0xcffe17",
      "low_end_site": "0xcfffaf",
      "stage": 3
    },
    {
      "action": "Bank.EndUpdate releases counter0 and publishes bank Changed. Its root object link follower causes expression-controller Changed and force Evaluate of the Block expression.",
      "high_end_site": "0xcffe34",
      "low_end_site": "0xcfffcc",
      "stage": 4
    },
    {
      "action": "Expression result is the same Block object-reference attribute and current dereferenced block. SetRootElement skips same root pointer at0x84ed31. Controller tracked Changed invokes DoRootElementChanged and Update; Update skips same current pointer at0x84eee1. No DoCurrentElementChanged/value-change handler is emitted, so no delayed HandleBlockChange aggregate refresh.",
      "qualification": "Requires existing identical Block binding; a separate change of Block reference is a different event.",
      "stage": 5
    },
    {
      "action": "After release, High handler may lower Low when Active and High<Low; Low handler may raise High when Active and Low>High. Any such nested Lux handler repeats these same update guards.",
      "high_crossing_write": "0xcffe6e",
      "low_crossing_write": "0xd00006",
      "stage": 6
    }
  ],
