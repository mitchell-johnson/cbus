  "recovered_rules": [
    {
      "method": "ComboBoxAddEdit.AddObject",
      "rule": "Blank Group Add uses the current list application. A null reply changes no selection. An accepted decimal address selects the matching refreshed item and writes its SelectedValue binding."
    },
    {
      "method": "EDLTUnit.AfterLoadPPData / PPAttributeDataSourceLogic",
      "rule": "Corridor uses PrimaryApplication groups. Link permits255; Office and Corridor controls are disabled by Link255 and lists exclude the other roles. Absent stored selections follow the existing Corridor Show normalization."
    },
    {
      "method": "CBusApplication.ReadXmlData / BindingListCBusObject.PopulateList",
      "rule": "Refreshed group lists use explicit group sort preference: address order or case-insensitive TagName order. Exclusions and virtual255 entries belong to the view. Database child order alone does not establish that preference."
    },
    {
      "method": "FrmBaseUnit.InitializeComponent / btnAddGroup_Click",
      "rule": "Activation group list uses202 in mode3 and PrimaryApplication otherwise. Standby duration enables its controls, event modes2/3 expose Group Add. Mode3 and selected group other than255 expose Action Add, which requests a blank Level address under202/currentProximityGroup."
    },
    {
      "method": "TCBusApplicationGUIAgent.AddGroup / TfrmGroupAssign",
      "rule": "First-free group address0..254, reserved255. The editable seed is the source application noun plus first-free address. Accepted group names trim before blank, exact Project.TagName and ASCII-insensitive duplicate validation. Cancel frees the provisional object."
    },
    {
      "method": "TCBusApplicationGUIAgent.AddLevel / TfrmLevelAssign",
      "rule": "First-free Level address0..254 with Level N seed; explicit address leaves the Level seed when the Action Selector prefix does not match. Duplicate lookup compares the entered untrimmed name with ASCII UpperCase, then accepted names trim. Project.TagName is exact. Address equals Value. Cancellation writes no binding."
    },
    {
      "method": "CBusNetwork.GetApplicationByAddress / CBusApplication.GetGroupByAddress / SceneManager retained getter model",
      "rule": "Fresh model default bAdd=true permits exact getter creations. Ordered dialog histories admit only objects already present or established by preceding getter/dialog receipts. Parent bindings reuse the owning panel editor and one final parent save."
    },
    {
      "method": "EDLTUnit.AfterLoadPPData / LoadScenes / retained Corridor Show",
      "rule": "Initial scene trigger/action getters run before controls whether or not SceneManager is opened later. Initial and per-operation Corridor absence facts come from the complete inventory at the actual binding, including after an Application switch; a future Add cannot make an earlier missing stored selection present retroactively."
    }
  ],
