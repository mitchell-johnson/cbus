  "deferred_reads": {
    "boolean_read": "0x7f43d8",
    "attribute_resolve": "0x7ecd00",
    "manager_resolve": "0x7ee114",
    "target_resolve": "0x76a444",
    "effect": "Clears the change marker at offset 0x1d only; no lazy programming load or change to Boolean value offset 0x70."
  },
  "hook_sequence": [
    {
      "method": "0x12f16c8",
      "effect": "KeyToNeo tweaker applies inherited suppression and IndicatorFunction remap before target hooks."
    },
    {
      "method": "0xcc5f70",
      "effect": "LearnMode and LearnAnyApp mutable become true; LearnedFlag mutable becomes false for fresh false/false model history.",
      "enabled_virtual": "0xce64f0",
      "enabled_predicate": "constant true, independent of firmware text"
    },
    {
      "method": "0xcc9180",
      "effect": "Source HasApplication2 is false, so secondary-application scrub is skipped. Source is not Neo, target is Neo, so GroupAddress becomes source[0:4] + [255,255,255,255] + [source[4]].",
      "group_format": "Nine uppercase 0xNN tokens, one space between tokens, no trailing space.",
      "brightness_mutable_after_core_hook": true,
      "brightness_virtual": "0xc9e124"
    },
    {
      "method": "0xcedc88",
      "effect": "Source is not CoreNeoPro, so the 13 original NeoPro tail attributes become immutable."
    },
    {
      "method": "0x121f6cc",
      "inherited_call_at": "0x121f6d6",
      "flag_write_at": "0x121f6e4",
      "agent_attribute_offset": "0x108",
      "mutable_flag_offset": "0x58",
      "effect": "After inherited hooks, sets IndicatorBrightness mutable false unconditionally."
    }
  ],
  "final_flags": {
    "LearnMode": true,
    "LearnAnyApp": true,
    "LearnedFlag": false,
    "IndicatorBrightness": false
  },
  "conclusions": [
    "These five directions need the coupler final brightness suppression; the classic-key-to-Neo final brightness=true policy is incorrect here.",
    "Fresh learned model flags remain false/false before the hook. Native PP LearnedFlag defaults or source PP values do not supply model history.",
    "The learning-enabled predicate differs from classic Neo targets: the coupler override returns true without comparing firmware.",
    "All source models have HasApplication2=false and lack Neo/CoreNeoPro ancestry. All target models inherit both, activating classic-to-Neo group reshaping and the NeoPro suppression tail."
  ],
  "limitations": [
    "Static original source proof only; original GUI execution and physical acceptance are not claimed.",
    "Only the declared fresh-target firmware/schema profile is proposed; constant virtual behavior is not blanket admission of other firmware or schemas.",
    "Existing or edited targets require real model history; raw PP strings cannot establish LearnedFlagOriginal.",
    "Schema aliasing, missing source PP names, target native defaults and persistence require separate native evidence."
  ],
