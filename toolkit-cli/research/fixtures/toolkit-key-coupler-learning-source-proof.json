    },
    {
      "at": "0xcaeec6",
      "operation": "Load source UnitAttributes, Database, LiveAgentMode."
    },
    {
      "at": "0xcaeef5",
      "operation": "Load source ProgrammingParameters, Database. Learning-state hydration here belongs to the source instance."
    },
    {
      "at": "0xcaef36",
      "operation": "Store selected tweaker at target offset 0x15c."
    },
    {
      "at": "0xcaef65",
      "operation": "Save target UnitCreate, Database; AgentSave creates database identity and scalar attributes, not programming parameters."
    },
    {
      "at": "0xcaef94",
      "operation": "Load target UnitAttributes, Database; dispatch uses LoadDatabaseUnitAttributes at 0xcb8c44."
    },
    {
      "at": "0xcaefb5",
      "operation": "Save target AlignUnit; AlignUnit first calls AlignUnitNoSave at 0xcc02fd."
    },
    {
      "at": "0xcc067c",
      "operation": "AlignUnitNoSave calls tweaker after same-name agent string alignment."
    },
    {
      "at": "0xcc0684",
      "operation": "AlignUnitNoSave dispatches BeforeUnitConversionSave, including the learning hook."
    },
    {
      "at": "0xcc0312",
      "operation": "Only after the hook returns, AlignUnit sets up target programming information."
    },
    {
      "at": "0xcc032e",
      "operation": "Target PP load occurs after the learning hook; it is not an earlier source of target model history."
    },
    {
      "at": "0xcc0338",
      "operation": "PP SET sequence uses final writable flags."
    },
    {
      "at": "0xcc03a1",
      "operation": "Later AlignUnit flow reloads target ProgrammingParameters after its save; this cannot retroactively affect the hook."
    }
  ],
