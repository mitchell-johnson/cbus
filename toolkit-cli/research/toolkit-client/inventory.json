{
  "schema_version": 1,
  "subject": "Native reply-code compares of the C-Bus Toolkit 1.18.0.2754 C-Gate client",
  "purpose": "Machine-readable record of every reply check each native Toolkit C-Gate client class performs, so repository tests and cgate-mock can assert against them.",
  "recording": "Transcribed from the static decompile findings recorded in repository issue #161. Nothing here is observed behaviour; it is recovered client source semantics. Replies not among an entry's recorded fragments are treated as unmodeled by this repository's fail-closed handlers.",
  "recovery": {
    "method": "Static analysis of C-Bus Toolkit 1.18.0.2754.",
    "tools": [
      "REA over the managed DLLs (SharpCGateCommunicator 7.15)",
      "Ghidra 12.1.4 decompile of the Delphi CBusToolkit.exe with CBusToolkit.map symbols (680 methods, every CIS_Tcgc* class, the socket layer and the reply parser)"
    ],
    "execution": "Nothing was executed.",
    "off_repository_bounds": [
      "vendor binaries",
      "decompiled source",
      "key material"
    ]
  },
  "managed_client_facts": {
    "client": "SharpCGateCommunicator 7.15",
    "tls_port": 20123,
    "plain_port": 20023,
    "default_timeout_seconds": 10,
    "timeouts_seconds": {
      "DBGetXml": 11,
      "PPLoad": 60,
      "PPSave": 20,
      "ProjectLoad": 15,
      "ProjectSave": 15,
      "PPGetUnitSpec": 15,
      "PPInfo": 15
    },
    "timeout_error_code": 9999
  },
  "shared_reply_parser": {
    "command_framing": "Commands go out as [<id>] <command>.",
    "line_reading": "Replies are read line by line to LF.",
    "event_line": "A line whose 1st and 3rd characters are # (#c#, #e#, #s#) is an event.",
    "no_command_waiting": {
      "421": "connection refused",
      "201": "connected; Toolkit reads the cmd-syntax version from it"
    },
    "tagged_lines": "Otherwise the first character must be [ or the line is dropped. Digits to ] are the id; the next character must be a space.",
    "status_code": "The code runs to the first space or -; - marks a continuation row. The code goes through StrToIntDef(code, 0).",
    "row_dispatch": "Every row, continuations included, goes to the class's OnProcessResults in order; rows are never merged. Unknown ids are dropped.",
    "completion": "A command finishes when the character after a 3-digit code is a space. Some classes finish earlier.",
    "error_policy": "Only the first error raised counts."
  },
  "compatibility_notes": [
    {
      "observer": "repository issue #160",
      "note": "Native servers answer LOGIN user pass with 211; the Toolkit client parses only 210/400/422. cgate-mock keeps its native behavior and the quirk is documented, not modelled."
    }
  ],
  "low_confidence": [
    "argument layouts (from string joins)",
    "DBGet 401",
    "ProjectSave 408",
    "the Event 412-421 range"
  ],
