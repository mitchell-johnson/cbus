 "probe": "rust/cbus-cgate/research/native_lighting_event_probe.py",
 "scope": "Captured from an isolated owned C-Gate 3.4 daemon whose only network is a disposable project on the ephemeral Toolkit PCI simulator; synthetic monitor-mode SAL lines were written on that loopback connection and a second command session issued Lighting commands. The project database defines Lighting application 56 and group 7 with synthetic OIDs; other groups are created by bus traffic. No site project, lighting hardware, Docker service, or live C-Bus network was used. Project names are replaced by PROJECT, generated network and interface OIDs by placeholders, timestamps by <timestamp>, command sessions by cmd<session> and the ephemeral client port by <port>.",
 "session_event_mode": "EVENT e9s9c0",
 "native_format": {
  "event_730": "<timestamp> 730 <group address> <group OID or -> new level=L sourceunit=S ramptime=T[ sessionId=cmdN commandId=TAG]; level 7. A terminated ramp logs 'ramp terminated new level=L sourceunit=S' instead.",
  "status_row": "lighting <action> <group address> <arguments> #sourceunit=S OID=<group OID or empty>[ sessionId=cmdN commandId=TAG]; action 'on'/'off' for an instant 255/0 with an empty argument field, 'ramp' with 'LEVEL SECONDS' otherwise, and 'terminateramp' with '#level=L'.",
  "source_zero": "A zero source byte is printed as sourceunit=0.",
  "unchanged_level": "A repeated OFF still emits both rows.",
  "routing": "A point-to-multipoint row with a nonzero routing byte is accepted as direct traffic; an inbound point-to-point-to-multipoint row is logged as 824 unknown response and produces no lighting rows."
 },
 "cmqttd_contract": "cmqttd emits the event-730 and status rows for each attributed inbound ON, OFF and RAMP SAL, with the database Group OID when one is defined. A zero source byte keeps decoding as unattributed and is neither cached nor reported. Inbound TERMINATERAMP (whose native level is an interpolated ramp position), the 702 phantom-group rows, and the command-context suffix of cmqttd's own commands are not reproduced.",
 "setup": [
