# Container timezone
TZ=Pacific/Auckland

# MQTT broker
MQTT_SERVER=mqtt.example.com
MQTT_PORT=1883
MQTT_USE_TLS=0
CMQTTD_VERBOSITY=INFO

# C-Bus endpoint. Set CNI_ADDR or SERIAL_PORT.
CNI_ADDR=192.168.1.10:10001
# SERIAL_PORT=/dev/ttyUSB0

# Runtime behavior
CBUS_TIMESYNC=300
CBUS_CLOCK=1
CBUS_STATUS_RESYNC=300
CMQTTD_CBUS_NETWORK=My Network

# Embedded C-Gate service (requires cmqttd_config/project.cbz).
# Use off to run MQTT only. Compose persists state in its cmqttd_data volume.
# This is the container bind; Compose publishes it on the Mac/host loopback only.
CMQTTD_CGATE_BIND=0.0.0.0:20023
