# Container timezone
TZ=Pacific/Auckland

# MQTT broker
MQTT_SERVER=mqtt.example.com
MQTT_PORT=1883
MQTT_USE_TLS=0
CMQTTD_VERBOSITY=INFO

# C-Bus endpoint. Set CNI_ADDR or SERIAL_PORT.
CNI_ADDR=192.168.1.10:10001
# SERIAL_PORT=/dev/ttyUSB0

# Runtime behavior
CBUS_TIMESYNC=300
CBUS_CLOCK=1
CMQTTD_CBUS_NETWORK=My Network
